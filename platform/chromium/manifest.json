{
  "manifest_version": 3,
  "name": "__MSG_extNameChrome__",
  "version": "1.4.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "action": {
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    },
    "default_popup": "ui/popup.html"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://store.steampowered.com/*"
      ],
      "exclude_matches": [
        "https://store.steampowered.com/marketingmessages/*"
      ],
      "js": [
        "src/escape.js",
        "src/presets.js",
        "src/ai-disclosure.js",
        "src/settings-schema.js",
        "src/queue-common/steam-palette.js",
        "src/stats.js",
        "src/steam-net.js",
        "src/utils.js",
        "src/game-name.js",
        "src/master-switch.js",
        "src/gate.js",
        "src/creators.js",
        "src/steam-activity.js",
        "src/ignored-total.js",
        "src/ignore-log.js",
        "src/surface.js",
        "src/i18n.js",
        "src/toast.js",
        "src/queue-common/sale-reward.js",
        "src/queue-common/automation-notice.js",
        "src/curator/lease.js",
        "src/curator/store.js",
        "src/curator/done-marks.js",
        "src/sw-handoff.js",

        "src/manual-ignore/config.js",
        "src/manual-ignore/containers.js",
        "src/manual-ignore/gestures.js",
        "src/manual-ignore/mark-dom.js",
        "src/manual-ignore/ai-marks.js",
        "src/manual-ignore/ui.js",
        "src/manual-ignore/bundle.js",
        "src/manual-ignore/creators-ui.js",
        "src/manual-ignore/marks.js",
        "src/manual-ignore/shot.js",
        "src/manual-ignore/ai-browse.js",
        "src/manual-ignore/ai-page.js",
        "src/manual-ignore/ignore-manager.js",
        "src/manual-ignore/main.js",
        
        "src/discovery-queue/ui.js",
        "src/discovery-queue/registry.js",
        "src/discovery-queue/logic.js",
        "src/discovery-queue/main.js",

        "src/explore-queue/utils.js",
        "src/explore-queue/ui.js",
        "src/explore-queue/automator.js",
        "src/explore-queue/main.js",

        "ui/icons.js",
        "src/curator/filters.js",
        "src/curator/enumerate.js",
        "src/curator/cache.js",
        "src/curator/enqueue-service.js",
        "src/curator/button-style.js",
        "src/curator/menu.js",
        "src/curator/main.js",
        "src/curator/drainer.js",
        "src/curator/drainer-host.js",
        "src/undo-service.js",

        "ui/popup_markup.js",
        "ui/popup_settings.js",
        "ui/popup_tabs.js",
        "ui/popup_presets.js",
        "ui/popup_ai.js",
        "ui/popup_queue_rows.js",
        "ui/popup_queue.js",
        "ui/popup_undo.js",
        "ui/popup_history.js",
        "ui/popup_main.js",
        "src/widget/main.js",
        "src/manual-ignore/list-frame.js"
      ],
      "css": ["styles/styles.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/icons/icon16.png", "assets/icons/icon48.png", "ui/popup.css", "data/presets.json"],
      "matches": ["https://store.steampowered.com/*"]
    }
  ]
}